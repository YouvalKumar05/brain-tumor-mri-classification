# ============================================================
# Brain Tumor MRI Classification — .gitignore
# ============================================================

# ----------------------------
# DATASET — never commit raw or processed image data
# ----------------------------
data/raw/
data/processed/
*.zip
*.tar.gz
*.tar
*.7z

# Keep data README
!data/README.md

# ----------------------------
# Python
# ----------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
*.so

# ----------------------------
# Virtual Environments
# ----------------------------
venv/
env/
.venv/
.env/
ENV/
.conda/
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/

# ----------------------------
# Jupyter Notebooks
# ----------------------------
.ipynb_checkpoints/
*/.ipynb_checkpoints/
**/.ipynb_checkpoints/

# ----------------------------
# Model Checkpoints & Large Outputs
# ----------------------------
outputs/checkpoints/
outputs/predictions/
# Keep figures and metrics (needed for reports)
!outputs/figures/
!outputs/metrics/
!outputs/explanations/

# ----------------------------
# Environment Variables
# ----------------------------
.env
.env.local
.env.*.local

# ----------------------------
# macOS
# ----------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.AppleDouble
.LSOverride
Icon

# ----------------------------
# IDE & Editors
# ----------------------------
.vscode/settings.json
.vscode/launch.json
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace

# ----------------------------
# Temporary & Logs
# ----------------------------
*.log
*.tmp
*.temp
logs/
temp/
tmp/

# ----------------------------
# Testing
# ----------------------------
.pytest_cache/
.coverage
htmlcov/
.tox/
*.egg

# ----------------------------
# Weights & Biases / MLflow
# ----------------------------
wandb/
mlruns/
mlartifacts/

# ----------------------------
# Experiment artifacts (large)
# ----------------------------
experiments/*/weights/
experiments/*/checkpoints/

# ----------------------------
# Distribution / Packaging
# ----------------------------
*.egg-info/
dist/
build/
